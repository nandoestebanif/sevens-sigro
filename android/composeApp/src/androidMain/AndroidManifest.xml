<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Cámara para la foto de la guía de remisión: se pide en tiempo de ejecución (3 estados). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- required=false: la app se instala igual en un equipo sin cámara (la opción se oculta). -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- usesCleartextTraffic=false: http apagado por defecto en toda versión de Android; networkSecurityConfig: en release, ninguna
         excepción; en debug, el emulador y la PC de desarrollo (manifestPlaceholders redSegura). El ambiente de pruebas y la nube van por https. -->
    <application
        android:name=".SigroApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="${redSegura}"
        android:theme="@style/Tema.Sigro">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Comparte con la cámara del sistema solo la carpeta files/fotos (ver res/xml/rutas_fotos.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fotos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_fotos" />
        </provider>
    </application>
</manifest>
