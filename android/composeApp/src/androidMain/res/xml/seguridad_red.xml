<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Versión release: todo por https, sin excepciones y solo con las CA del sistema (MobSF, 27/11).
         Las excepciones para el emulador y la PC local viven en seguridad_red_debug.xml (solo debug). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
