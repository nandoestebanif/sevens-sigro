skinparam StateEndColor #1F2A44
skinparam NoteBackgroundColor #F3F4F6
skinparam NoteBorderColor #9CA3AF
skinparam TitleFontSize 15
skinparam TitleFontColor #C2410C
skinparam ClassBorderColor #1F2A44
skinparam ClassBackgroundColor #FFF7ED
hide empty description
title E11 · Estados del trabajador y de su jornada\nHU-62, HU-63
state Trabajador {
  [*] --> Activo : registrar con fecha de ingreso (HU-62)
  Activo --> DeBaja : retirar con fecha de salida
  state "De baja" as DeBaja
  DeBaja : no aparece en la asistencia;\nsus jornadas se conservan
}
state Jornada {
  [*] --> Registrada : asistencia del día (HU-63)
  Registrada --> Corregida : corrección
  Corregida : registro nuevo que apunta al anterior
}
@enduml
