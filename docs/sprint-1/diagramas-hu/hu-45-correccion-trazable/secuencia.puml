title HU-45 · Corrección trazable\nDiagrama de secuencia
autonumber
actor "Almacenero" as U
participant "Web de oficina" as UI
participant "API Gateway" as GW
participant "Servicio Almacén" as SA
database "BD · esquema almacen" as BD
U -> UI : «Corregir» la salida #128 (motivo)
UI -> GW : POST /api/v1/obras/{id}/almacen/movimientos/128/reverso
GW -> SA : reenvía
SA -> BD : ¿#128 ya tiene reverso?
alt ya revertido
  SA --> GW : 409
  GW --> UI : 409
else
  SA -> BD : INSERT reverso (apunta a #128, autor, motivo)
  note right of BD : No hay UPDATE ni DELETE\nsobre movimientos
  SA -> BD : saldo = movimientos vigentes
  SA --> GW : 201 reverso
  GW --> UI : 201 reverso
  UI --> U : #128 anulado · reverso #131 visible
end
@enduml
