skinparam PackageFontColor #1F2A44
skinparam PackageStyle rectangle
skinparam ArrowFontSize 10
skinparam ArrowFontColor #374151
skinparam nodesep 40
skinparam ranksep 50
hide empty members
hide circle
skinparam LegendBackgroundColor #F9FAFB
skinparam LegendBorderColor #9CA3AF
skinparam LegendFontSize 12
title HU-01 · Creación del proyecto\nDiagrama de clases
package "Web de oficina (React + TypeScript)" #EFF6FF {
class ObraPagina <<página>> {
  archivo : Obra.tsx
}
class ClienteHttp <<api>> {
  +pedir() «camelCase ↔ snake_case»
  +fechaHoraLima() «horaLima.ts»
}
}
package "Seguridad y filtros · Spring Boot (todas las rutas)" #F5F3FF {
class Filtros <<filtros HTTP>> {
  CabecerasSeguridad «nosniff, DENY, CSP, HSTS, no-store»
  BitacoraFiltro «POST y 401/403, sin datos sensibles»
}
class Acceso <<seguridad>> {
  +exigir(accion, obraId) : Actor «401 · 403»
  +exigirEnAlgunaObra(accion) : Actor
  -exigirPin(actor, accion) «X-SIGRO-PIN»
  Permisos.MATRIZ «51 acciones × 5 roles»
}
}
package "Módulo obra · esquema obra · rol sigro_svc_obras" #FFF7ED {
class ObraController <<@RestController>> {
  +login()
  +crearObra() / ampliarPlazo() / cerrarObra()
  +periodos() / cerrarPeriodo()
  +crearAlmacen()
  +crearUsuario() / baja() / claveTemporal()
  +asignar() / retirar()
  +solicitarDispositivo() / autorizar() / revocar()
  +yo() / cambiarClave()
}
class Proyecto <<obra>> {
  id : bigint
  nombre : text
  fecha_inicio : date
  fecha_fin : date «≥ inicio»
  dia_corte : smallint
  estado : en_ejecucion | cerrado
}
class Periodo <<semana de control>> {
  numero : int
  fecha_inicio : date
  fecha_fin : date
  estado : abierto | cerrado
}
class Almacen {
  nombre : text
  tipo : central | frente
  estado : activo | inactivo
}
class Usuario #F3F4F6;line:9CA3AF
}
Proyecto "1" *-- "1..*" Periodo : se divide en
Proyecto "1" *-- "1..*" Almacen
ObraController ..> Proyecto : crea
ObraController ..> Periodo : genera
ObraController ..> Usuario : verifica
ObraController ..> Acceso : exigir(permiso, obra)
ObraPagina ..> ClienteHttp
ClienteHttp ..> Filtros : HTTPS /api/v1 + JWT
Filtros ..> Acceso : cada petición
legend bottom left
<b>Regla que protege:</b> La fecha de fin no puede ser anterior a la de inicio (CHECK en la base). La obra nace
«en_ejecucion».
<i>Gris: clases de otro módulo o de contexto (se le pide a su clase, nunca a su esquema).</i>
endlegend
@enduml
