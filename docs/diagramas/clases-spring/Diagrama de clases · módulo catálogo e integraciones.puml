title SIGRO · Diagrama de clases · módulo catálogo e integraciones (Spring Boot)
package "Módulo catálogo · esquema catalogo · rol sigro_svc_catalogo" #FFF7ED {
class Insumo {
  codigo : text «único en todas las obras»
  descripcion : text
  medida : text
  norma : text
  marca : text
  unidad_compra : text
  factor_conversion : numeric
  tipo : material | mano_obra | equipo | subcontrato
  verificado : bool
}
class InsumoNombreComercial {
  nombre : text
}
class InsumoFactorHistorial <<solo INSERT>> {
  factor_anterior : numeric
  factor_nuevo : numeric
  motivo : text
  cambiado_por : bigint
  cambiado_en : timestamptz
}
class CatalogoController <<@RestController>> {
  +listar()
  +registrar() «normalizar()»
  +verificar()
  +factor() / historial()
  +leerPdf() / importar() «S10»
}
}
package "Integraciones (S10, SUNAT, RENIEC) · dentro del backend" #FFF7ED {
class LectorS10 <<componente>> {
  +leer(pdf) : relación de insumos
  PDFBox 3
}
class LecturaS10 <<valor>> {
  obra : text
  subpresupuesto : text
  fecha : text
  insumos : list
  fallidos : list «con su motivo»
}
class Padron <<componente>> {
  +ruc(ruc)
  +dni(dni)
  Factiliza | apisperu · caché 24 h
}
}
Insumo "1" -- "0..*" InsumoNombreComercial
Insumo "1" -- "0..*" InsumoFactorHistorial : historial
LectorS10 ..> LecturaS10 : devuelve
CatalogoController ..> Insumo : crea / actualiza
CatalogoController ..> InsumoFactorHistorial : registra
CatalogoController ..> LectorS10 : lee el PDF (en proceso)
CatalogoController ..> InsumoNombreComercial
@enduml
