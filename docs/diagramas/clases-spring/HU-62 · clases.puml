title HU-62 · Registro del trabajador\nDiagrama de clases
package "App del almacenero (Kotlin Multiplatform)" #ECFDF5 {
class TrabajadorNuevoViewModel <<ViewModel>> {
  +guardar(obraId)
}
interface RepositorioTrabajadores {
  +deObra(obraId) : Flow
  +actualizar(obraId)
  +registrar(obraId, nuevo)
}
class ApiSigro <<Ktor>> {
  +iniciarSesion()
  +enviarSalida()
  +enviarRegistro()
  +verificarRecepcion()
  +estadoRecepcion()
  +stock()
  +corregirJornada()
  +solicitarDispositivo()
}
}
package "Seguridad y filtros · Spring Boot (todas las rutas)" #F5F3FF {
class Filtros <<filtros HTTP>> {
  CabecerasSeguridad «nosniff, DENY, CSP, HSTS, no-store»
  BitacoraFiltro «POST y 401/403, sin datos sensibles»
}
class Acceso <<seguridad>> {
  +exigir(accion, obraId) : Actor «401 · 403»
  +exigirEnAlgunaObra(accion) : Actor
  -exigirPin(actor, accion) «X-SIGRO-PIN»
  Permisos.MATRIZ «51 acciones × 5 roles»
}
}
package "Integraciones (S10, SUNAT, RENIEC) · dentro del backend" #FFF7ED {
class Padron <<componente>> {
  +ruc(ruc)
  +dni(dni)
  Factiliza | apisperu · caché 24 h
}
}
package "Módulo tareo · esquema tareo · rol sigro_svc_tareo" #FFF7ED {
class TareoController <<@RestController>> {
  +registrar() / baja()
  +jornada() / corregir()
  +jornadas() / horas()
  +consultarDni()
}
class Trabajador {
  nombre : text
  tipo_documento : DNI | CE | PASAPORTE
  documento : text
  categoria : operario | oficial | peon
  cuadrilla : text
  fecha_ingreso : date
  fecha_salida : date «baja, no se borra»
}
}
TareoController ..> Trabajador
TareoController ..> Padron : consulta DNI (Padron)
TareoController ..> Acceso : exigir(permiso, obra)
ApiSigro ..> Filtros : HTTPS /api/v1 + JWT
TrabajadorNuevoViewModel --> RepositorioTrabajadores
RepositorioTrabajadores ..> ApiSigro
Filtros ..> Acceso : cada petición
legend bottom left
<b>Regla que protege:</b> Nombre, documento, categoría y cuadrilla; único por obra. Quien se retira se da de baja con su
fecha: sus jornadas se conservan (regla 10).
<b>Estado:</b> Siguiente iteración: vuelve del Sprint 1 con avance; su aceptación queda pendiente.
<i>Gris: clases de otro módulo o de contexto (se le pide a su clase, nunca a su esquema).</i>
endlegend
@enduml
