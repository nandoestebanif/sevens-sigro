title HU-37 · Registro sin señal\nDiagrama de clases
package "App del almacenero (Kotlin Multiplatform)" #ECFDF5 {
class SalidaViewModel <<ViewModel>> {
  +guardar(obraId)
  estado : StateFlow
}
class ValidarSalida <<dominio>> {
  +errores(insumo, cantidad, motivo, quienRetira)
  +normalizarCantidad()
}
interface RepositorioSalidas {
  +registrar(nueva) : SalidaRegistrada
  +sincronizar() : ResultadoSincronizacion
}
class RepositorioSalidasImpl {
  +registrar()
  +sincronizar() «una a la vez»
}
class SalidaLocalEntity <<Room>> {
  uuidCliente : String «PK»
  insumoId, cantidad, motivo, quienRetira
  estado : PENDIENTE | ENVIADO | RECHAZADO
  intentos : Int
  motivoRechazo : String?
}
}
SalidaViewModel --> RepositorioSalidas
SalidaViewModel ..> ValidarSalida : valida
RepositorioSalidasImpl ..|> RepositorioSalidas
RepositorioSalidasImpl --> SalidaLocalEntity : guarda primero
RepositorioSalidasImpl ..> ValidarSalida
legend bottom left
<b>Regla que protege:</b> La salida se guarda primero en el celular (Room) con su uuid_cliente y estado PENDIENTE. La app no
calcula el saldo.
<i>Gris: clases de otro módulo o de contexto (se le pide a su clase, nunca a su esquema).</i>
endlegend
@enduml
