title SIGRO · Diagrama de clases · módulo costo, tareo y outbox (Spring Boot)
package "Módulo costo · esquema costo · rol sigro_svc_costo" #FFF7ED {
class Hecho <<modelo de lectura>> {
  familia : materiales | equipos | mano_de_obra
  clase : text
  insumo_codigo : text
  cantidad : numeric
  costo_unitario : numeric
  importe : numeric
  fecha : date
}
class EventoRecibido {
  evento_id : uuid «deduplica»
  recibido_en : timestamptz
}
class GastoPorObra <<vista>> {
  gasto por familia de recurso
}
class CostoController <<@RestController>> {
  +gasto(corte) «5 cifras al mismo corte»
  +inventario(corte)
  +desviacion()
  toleranciaRedondeo(hechos)
}
class EventosCosto <<@RestController>> {
  +registrar(evento) «idempotente por evento_id»
}
class RelevoCosto <<@Scheduled cada 5 s>> {
  -uno() «FOR UPDATE SKIP LOCKED»
  +vuelta() «reintentos 5 s … 1 h»
}
}
package "Módulo tareo · esquema tareo · rol sigro_svc_tareo" #FFF7ED {
class Trabajador {
  nombre : text
  tipo_documento : DNI | CE | PASAPORTE
  documento : text
  categoria : operario | oficial | peon
  cuadrilla : text
  fecha_ingreso : date
  fecha_salida : date «baja, no se borra»
}
class Jornada <<solo INSERT>> {
  uuid_cliente : uuid
  fecha : date
  estado : presente | ausente | permiso
  horas_normales : numeric
  horas_extra : numeric
  corrige_a_id : bigint
  motivo_correccion : text
}
class JornadaVigente <<vista>> {
  la última versión de cada jornada
}
class HorasAcumuladas <<vista>> {
  horas por trabajador y periodo
}
class TareoController <<@RestController>> {
  +registrar() / baja()
  +jornada() / corregir()
  +jornadas() / horas()
  +consultarDni()
}
class Tareo <<API del módulo>> {
  +horas(obraId, hasta) «la usa costo»
}
}
package "Outbox · esquema outbox" #FFF7ED {
class Evento <<outbox>> {
  tipo : text
  payload : jsonb
  destino : text
  intentos : int
  siguiente_intento : timestamptz
  enviado_en : timestamptz
}
}
Trabajador "1" -- "0..*" Jornada
Jornada "0..1" --> "1" Jornada : corrige_a
JornadaVigente ..> Jornada
HorasAcumuladas ..> Jornada
EventoRecibido "1" -- "0..*" Hecho : evento_id
GastoPorObra ..> Hecho
RelevoCosto ..> Evento : lee y marca enviado
RelevoCosto ..> CostoController : entrega el evento
CostoController ..> Hecho : registra / suma
CostoController ..> EventoRecibido : deduplica
CostoController ..> GastoPorObra : consulta
CostoController ..> HorasAcumuladas : horas (en proceso, tareo)
TareoController ..> Trabajador
TareoController ..> Jornada : inserta / corrige
TareoController ..> HorasAcumuladas : consulta
TareoController ..> JornadaVigente : consulta
RelevoCosto ..> EventosCosto : registrar() en proceso
CostoController ..> Tareo : horas() en proceso
@enduml
