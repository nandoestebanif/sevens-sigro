title HU-15 · Dispositivo autorizado\nDiagrama de clases
package "Web de oficina (React + TypeScript)" #EFF6FF {
class AdministracionPagina <<página>> {
  archivo : Administracion.tsx
}
}
package "App del almacenero (Kotlin Multiplatform)" #ECFDF5 {
class DispositivoViewModel <<ViewModel>> {
  +solicitar(obraId)
}
interface RepositorioDispositivo {
  +identificador()
  +estado(obraId)
  +solicitarAutorizacion(obraId)
}
class ApiSigro <<Ktor>> {
  +iniciarSesion()
  +enviarSalida()
  +enviarRegistro()
  +verificarRecepcion()
  +estadoRecepcion()
  +stock()
  +corregirJornada()
  +solicitarDispositivo()
}
}
package "Seguridad y filtros · Spring Boot (todas las rutas)" #F5F3FF {
class Filtros <<filtros HTTP>> {
  CabecerasSeguridad «nosniff, DENY, CSP, HSTS, no-store»
  BitacoraFiltro «POST y 401/403, sin datos sensibles»
}
class Acceso <<seguridad>> {
  +exigir(accion, obraId) : Actor «401 · 403»
  +exigirEnAlgunaObra(accion) : Actor
  -exigirPin(actor, accion) «X-SIGRO-PIN»
  Permisos.MATRIZ «51 acciones × 5 roles»
}
}
package "Módulo obra · esquema obra · rol sigro_svc_obras" #FFF7ED {
class ObraController <<@RestController>> {
  +login()
  +crearObra() / ampliarPlazo() / cerrarObra()
  +periodos() / cerrarPeriodo()
  +crearAlmacen()
  +crearUsuario() / baja() / claveTemporal()
  +asignar() / retirar()
  +solicitarDispositivo() / autorizar() / revocar()
  +yo() / cambiarClave()
}
class Dispositivo {
  identificador : text
  estado : pendiente | activo | revocado «2 activos por obra»
  fecha_autorizacion : timestamptz
  motivo_revocacion : text
}
class Usuario {
  id : bigint
  nombre : text
  usuario : text «único»
  hash_clave : text «Argon2id»
  estado : activo | baja
  intentos_fallidos : smallint
  bloqueado_hasta : timestamptz
  pin_hash : text «Argon2id, admin»
  pin_intentos : int
  pin_bloqueado_hasta : timestamptz
}
class Proyecto <<obra>> {
  id : bigint
  nombre : text
  fecha_inicio : date
  fecha_fin : date «≥ inicio»
  dia_corte : smallint
  estado : en_ejecucion | cerrado
}
}
package "Módulo almacén · esquema almacen · rol sigro_svc_almacen" #FFF7ED {
class AlmacenController <<@RestController>> #F3F4F6;line:9CA3AF
class AlmacenService <<@Service · casos de uso>> #F3F4F6;line:9CA3AF
class MovimientoRepository <<interfaz>> #F3F4F6;line:9CA3AF
class JdbcMovimientoRepository <<JDBC>> #F3F4F6;line:9CA3AF
}
Usuario "1" -- "0..2" Dispositivo : celular de
Proyecto "1" -- "0..*" Dispositivo
ObraController ..> Proyecto : crea
ObraController ..> Dispositivo : autoriza / revoca
ObraController ..> Usuario : verifica
ObraController ..> Acceso : exigir(permiso, obra)
AlmacenController ..> Acceso : exigir(permiso, obra)
ApiSigro ..> Filtros : HTTPS /api/v1 + JWT
DispositivoViewModel --> RepositorioDispositivo
RepositorioDispositivo ..> ApiSigro
Filtros ..> Acceso : cada petición
AlmacenController --> AlmacenService : delega
AlmacenService --> MovimientoRepository : usa
JdbcMovimientoRepository ..|> MovimientoRepository
legend bottom left
<b>Regla que protege:</b> Hasta dos celulares activos por obra (almacenero y SSOMA). El servidor rechaza el registro de un
celular no autorizado o revocado.
<i>Gris: clases de otro módulo o de contexto (se le pide a su clase, nunca a su esquema).</i>
endlegend
@enduml
