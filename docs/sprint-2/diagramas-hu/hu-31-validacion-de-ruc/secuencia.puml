title HU-31 · Validación de RUC\nDiagrama de secuencia
autonumber
actor "Almacenero" as U
participant "Web de oficina" as UI
participant "API Gateway" as GW
participant "Servicio Compras" as SC
participant "Integraciones" as IN
participant "SUNAT" as SU
database "BD · esquema compras" as BD
U -> UI : RUC 20606456892
UI -> UI : dígito verificador (sin red)
UI -> GW : POST /api/v1/proveedores
GW -> SC : reenvía
SC -> IN : GET /ruc/{ruc} (X-Servicio-Token)
IN -> SU : consulta del padrón (tiempo límite)
alt SUNAT responde
  SU --> IN : razón social, estado
  IN --> SC : RUC normalizado
  SC -> BD : proveedor «validado»
  SC --> GW : 201
  GW --> UI : 201
  UI --> U : razón social autocompletada
else SUNAT no responde
  IN --> SC : sin respuesta
  SC -> BD : proveedor «por validar»
  SC --> GW : 201 (por validar)
  GW --> UI : 201 (por validar)
  UI --> U : «Se validará después»; la compra sigue
end
U -> UI : «Validar de nuevo»
UI -> GW : POST /api/v1/proveedores/{id}/validar
@enduml
