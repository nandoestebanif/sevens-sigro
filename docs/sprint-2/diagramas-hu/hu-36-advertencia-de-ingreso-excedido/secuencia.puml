title HU-36 · Advertencia de ingreso excedido\nDiagrama de secuencia
autonumber
actor "Almacenero" as U
participant "App del almacenero" as APP
participant "API Gateway" as GW
participant "Servicio Almacén" as SA
participant "Servicio Compras" as SC
database "BD · esquema almacen" as BD
U -> APP : cantidades recibidas
APP -> GW : verificación previa de la recepción
GW -> SA : reenvía
SA -> SC : requerimiento del insumo (HU-19)
SC --> SA : requerido
SA -> BD : ya recibido
SA --> GW : requerido, ya recibido, exceso
GW --> APP : requerido, ya recibido, exceso
alt hay exceso
  APP --> U : advertencia antes de confirmar
  U -> APP : continúa y escribe el motivo
end
APP -> GW : POST /api/v1/obras/{id}/almacen/recepciones (motivo)
GW -> SA : reenvía
SA -> BD : recepción con motivo del exceso
SA --> GW : 201
GW --> APP : 201
@enduml
