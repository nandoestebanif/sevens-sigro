    "almacen.almacen_ref" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F6000"><TR><TD BGCOLOR="#7F6000"><FONT COLOR="white" POINT-SIZE="13"><B>Almacén (réplica en almacén)</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Nombre</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Tipo: central / frente</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Estado</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>Copia local de obra.almacen: almacén no lee el esquema obra</I></FONT></TD></TR></TABLE>>];
    "almacen.insumo_ref" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F6000"><TR><TD BGCOLOR="#7F6000"><FONT COLOR="white" POINT-SIZE="13"><B>Insumo (réplica en almacén)</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>Código</B></U></TD></TR><TR><TD ALIGN="LEFT"><FONT>Descripción</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Unidad</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Tipo</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>Copia local del catálogo</I></FONT></TD></TR></TABLE>>];
    "almacen.movimiento" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F6000"><TR><TD BGCOLOR="#7F6000"><FONT COLOR="white" POINT-SIZE="13"><B>Movimiento</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>Identificador del celular</B></U></TD></TR><TR><TD ALIGN="LEFT"><FONT>Tipo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Sentido: +1 / −1</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Cantidad</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Costo unitario (congelado)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Motivo (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Quién retira (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Origen (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Hora del celular (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Hora del servidor</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>Libro: solo se agrega · sin saldo guardado · corregir = reverso</I></FONT></TD></TR></TABLE>>];
    "almacen.recepcion" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F6000"><TR><TD BGCOLOR="#7F6000"><FONT COLOR="white" POINT-SIZE="13"><B>Recepción de compra</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>Identificador del celular</B></U></TD></TR><TR><TD ALIGN="LEFT"><FONT>Compra</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Motivo del exceso (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>Genera los ingresos de la compra</I></FONT></TD></TR></TABLE>>];
    "almacen.traslado" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F6000"><TR><TD BGCOLOR="#7F6000"><FONT COLOR="white" POINT-SIZE="13"><B>Traslado</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>Identificador del celular</B></U></TD></TR><TR><TD ALIGN="LEFT"><FONT>Motivo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Es cierre de obra</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>Una salida y un ingreso que se anulan juntos</I></FONT></TD></TR></TABLE>>];
    "almacen.conteo" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F6000"><TR><TD BGCOLOR="#7F6000"><FONT COLOR="white" POINT-SIZE="13"><B>Conteo físico</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>Identificador del celular</B></U></TD></TR><TR><TD ALIGN="LEFT"><FONT>Fecha</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Estado: borrador / confirmado</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>Al confirmarlo, cada diferencia es un ajuste con motivo</I></FONT></TD></TR></TABLE>>];
    "almacen.conteo_linea" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F6000"><TR><TD BGCOLOR="#7F6000"><FONT COLOR="white" POINT-SIZE="13"><B>Línea del conteo</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Saldo teórico</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Cantidad contada</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Diferencia</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Motivo (opcional)</FONT></TD></TR></TABLE>>];
    "almacen.prestamo" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F6000"><TR><TD BGCOLOR="#7F6000"><FONT COLOR="white" POINT-SIZE="13"><B>Préstamo de herramienta</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>Identificador del celular</B></U></TD></TR><TR><TD ALIGN="LEFT"><FONT>Cantidad</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Responsable</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Devolver el (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Prestado en</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Devuelto en (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Estado al volver: bueno / dañado / perdido (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>No mueve el saldo · no se presta más de lo disponible · se devuelve una vez</I></FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_costo { label=<<B>Costo (modelo de lectura)</B>>; fontsize=17; style="rounded,filled"; fillcolor="#E6F4F4"; color="#1F6F6F"; penwidth=2;
    "costo.evento_recibido" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F6F6F"><TR><TD BGCOLOR="#1F6F6F"><FONT COLOR="white" POINT-SIZE="13"><B>Evento recibido</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>Evento</B></U></TD></TR><TR><TD ALIGN="LEFT"><FONT>Tipo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Recibido en</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>Deduplica: un evento se aplica una vez</I></FONT></TD></TR></TABLE>>];
    "costo.hecho" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F6F6F"><TR><TD BGCOLOR="#1F6F6F"><FONT COLOR="white" POINT-SIZE="13"><B>Hecho de costo</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Familia: material / mano de obra / equipo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Clase</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Insumo (código)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Cantidad</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Costo unitario</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Importe</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Fecha</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>Llega de almacén por el outbox (RelevoCosto)</I></FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_outbox { label=<<B>Eventos (infraestructura)</B>>; fontsize=17; style="rounded,filled"; fillcolor="#FBEDE6"; color="#8A3B12"; penwidth=2;
    "outbox.evento" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8A3B12"><TR><TD BGCOLOR="#8A3B12"><FONT COLOR="white" POINT-SIZE="13"><B>Evento por avisar</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Tipo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Contenido</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Creado en</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Entregado en (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Intentos</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">Último error (opcional)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT POINT-SIZE="9" COLOR="#7F6000"><I>Se escribe en la misma transacción que el hecho</I></FONT></TD></TR></TABLE>>];
  }
