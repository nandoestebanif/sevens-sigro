  subgraph cluster_leyenda { label=<<B>Cómo leerlo</B>>; fontsize=16; style="rounded"; color="#666666";
    leyenda [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><U><B>Subrayado</B></U>  lo que identifica a la entidad (en una obra, nunca se repite)</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#777777">gris (opcional)</FONT>  puede quedar vacío</TD></TR><TR><TD ALIGN="LEFT"><B>||──</B> uno y solo uno · <B>|o──</B> uno o ninguno · <B>──o&lt;</B> ninguno, uno o varios</TD></TR><TR><TD ALIGN="LEFT">Leer así: «<I>Obra</I> se divide en (0..N) <I>Periodos</I>»; cada Periodo es de exactamente una Obra.</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><FONT COLOR="#7F6000"><I>Regla en amarillo</I>  lo que el motor de la base impide romper</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>Asignación</B> es la relación Usuario–Obra con atributo propio (el rol): una persona puede ser almacenero en una obra y nada en otra.</TD></TR><TR><TD ALIGN="LEFT">Quién registró, anuló, autorizó o cerró cada hecho (siempre un <B>Usuario</B>) no se dibuja para no saturar; está en el físico.</TD></TR><TR><TD ALIGN="LEFT">El contador del correlativo de solicitudes es una tabla técnica y no se dibuja.</TD></TR><TR><TD ALIGN="LEFT">Almacén usa réplicas locales del almacén y del insumo: no lee los esquemas obra ni catalogo.</TD></TR></TABLE>>];
  }
}