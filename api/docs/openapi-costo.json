  "/api/v1/obras/{obra_id}/costo/desviacion": {
   "get": {
    "tags": [
     "costo"
    ],
    "summary": "Desviacion",
    "description": "HU-57. Por insumo: consumo real (cantidad e importe al costo congelado) contra lo planificado por el S10, en cantidad,\nimporte y porcentaje, comparado con el avance del plazo. Los insumos consumidos que el S10 no planificó van aparte.",
    "operationId": "desviacion_api_v1_obras__obra_id__costo_desviacion_get",
    "security": [
     {
      "HTTPBearer": []
     }
    ],
    "parameters": [
     {
      "name": "obra_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "integer",
       "minimum": 1,
       "title": "Obra Id"
      }
     },
     {
      "name": "orden",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "description": "importe (por defecto) | porcentaje | cantidad | codigo",
       "default": "importe",
       "title": "Orden"
      },
      "description": "importe (por defecto) | porcentaje | cantidad | codigo"
     },
     {
      "name": "corte",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "AAAA-MM-DD o AAAA-MM-DDTHH:MM, hora de Lima; por defecto, ahora",
       "title": "Corte"
      },
      "description": "AAAA-MM-DD o AAAA-MM-DDTHH:MM, hora de Lima; por defecto, ahora"
     },
     {
      "name": "tolerancia",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "number",
         "maximum": 100.0,
         "minimum": 0.0
        },
        {
         "type": "string",
         "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
        }
       ],
       "description": "% de desviación que aún se lee «en rango»",
       "default": "10",
       "title": "Tolerancia"
      },
      "description": "% de desviación que aún se lee «en rango»"
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/DesviacionOut"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
