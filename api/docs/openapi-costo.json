  "/api/v1/obras/{obra_id}/costo/gasto": {
   "get": {
    "tags": [
     "costo"
    ],
    "summary": "Gasto",
    "description": "HU-58. Cinco cifras con su definición y UNA sola fecha de corte. Recibido, consumido y en stock salen del libro de\nAlmacén (el mismo cálculo del inventario, HU-56); comprado de Compras y las horas de Tareo. Si no cuadran entre sí, la\nrespuesta lo marca (`por_conciliar`) en vez de mostrar números que se contradicen.",
    "operationId": "gasto_api_v1_obras__obra_id__costo_gasto_get",
    "security": [
     {
      "HTTPBearer": []
     }
    ],
    "parameters": [
     {
      "name": "obra_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "integer",
       "minimum": 1,
       "title": "Obra Id"
      }
     },
     {
      "name": "corte",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "AAAA-MM-DD o AAAA-MM-DDTHH:MM, hora de Lima; por defecto, ahora",
       "title": "Corte"
      },
      "description": "AAAA-MM-DD o AAAA-MM-DDTHH:MM, hora de Lima; por defecto, ahora"
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/GastoOut"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/obras/{obra_id}/costo/inventario": {
   "get": {
    "tags": [
     "costo"
    ],
    "summary": "Inventario",
    "description": "Capital detenido en almacén: por insumo, cantidad × costo promedio ponderado a la fecha de corte (HU-56). Se\nreconstruye del libro de movimientos en Almacén; aquí solo se agrupa y se calcula el peso de cada insumo.",
    "operationId": "inventario_api_v1_obras__obra_id__costo_inventario_get",
    "security": [
     {
      "HTTPBearer": []
     }
    ],
    "parameters": [
     {
      "name": "obra_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "integer",
       "minimum": 1,
       "title": "Obra Id"
      }
     },
     {
      "name": "almacen",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "description": "`todos` (consolidado de la obra) o el id de un almacén",
       "default": "todos",
       "title": "Almacen"
      },
      "description": "`todos` (consolidado de la obra) o el id de un almacén"
     },
     {
      "name": "corte",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "AAAA-MM-DD o AAAA-MM-DDTHH:MM, hora de Lima; por defecto, ahora",
       "title": "Corte"
      },
      "description": "AAAA-MM-DD o AAAA-MM-DDTHH:MM, hora de Lima; por defecto, ahora"
